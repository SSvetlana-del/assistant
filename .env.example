GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_BASE_URL=https://api.giga.chat/v1
# Optional certificate bundle, if your OS does not trust the API certificate:
# GIGACHAT_CA_BUNDLE=/absolute/path/to/ca-bundle.pem
APP_DB=data/advisor.sqlite3
APP_HOST=127.0.0.1
APP_PORT=7860

# Supabase: Connect > Session pooler. Keep this value secret.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# BROWSER_SECRET=your-persistent-random-secret
